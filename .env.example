# Copy to .env.local. Never commit real values (.env* is git-ignored).

# Demo mode: in-memory sample data, no database. Set to false to use Supabase.
USE_MOCK_DATA=true

# Public origin of the site. Used for the links inside auth e-mails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase – required when USE_MOCK_DATA=false
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public by design: Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SECRET. Server only (rate-limit counters). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
