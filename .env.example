# Copy to .env.local. Never commit real values (.env* is git-ignored).

# Demo mode: in-memory sample data, no database. Set to false to use Supabase.
USE_MOCK_DATA=true

# Public origin of the site. Used for links inside e-mails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required when USE_MOCK_DATA=false) ---
NEXT_PUBLIC_SUPABASE_URL=
# Public by design: Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (transactional e-mail) ---
# SECRET. Server only. Without it e-mails are skipped and logged as "skipped".
RESEND_API_KEY=
# Sender, e.g. "שיתוף קהילתי <noreply@your-domain.com>". The domain must be
# verified in Resend; until then use "onboarding@resend.dev" (delivers only to
# the Resend account owner's own address).
EMAIL_FROM=

# --- Daily job (/api/cron/daily) ---
# SECRET. Long random string; Vercel Cron sends it as "Authorization: Bearer ...".
CRON_SECRET=

# --- Only for scripts/create-demo-users.ts ---
DEMO_USER_PASSWORD=
DEMO_ADMIN_PASSWORD=
